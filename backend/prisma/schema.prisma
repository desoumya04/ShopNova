// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Seller {
  id        String   @id @default(uuid())
  userId    String   @unique

  business Business?
  bank     Bank?

  accountStatus Account @default(PENDING_VERIFICATION)  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
model User {
  id        String   @id @default(uuid())
  
  name      String
  mobile    String? @unique
  email     String   @unique
 
  otp             String?
  otpExpiresAt    DateTime?   // ⭐ expiry timee
  otpAttempts     Int        @default(0)
  otpVerified     Boolean     @default(false)

  
  role Role @default(CUSTOMER)

  seller Seller?

  address UserAddress[]
  accountStatus Account @default(PENDING_VERIFICATION)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}
model Business {
  id          String   @id @default(uuid())
  sellerId    String   @unique

  name        String
  category    BusinessCategory @default(ELECTRONICS) 
  email       String
  mobile      String
  gstIn       String?
  
  address     BusinessAddress?
 
  seller      Seller   @relation(fields: [sellerId], references: [id])
}
model Bank {
  id          String   @id @default(uuid())
  sellerId    String @unique

  bankName    String
  accountHolder  String
  accountNumber String  @unique
  ifcCode    String?
  seller      Seller   @relation(fields: [sellerId], references: [id])
}

model UserAddress {
  id          String   @id @default(uuid())

  userId     String 

  locality String
  pinCode Int
  state String
  address String

  
  user     User   @relation(fields: [userId], references: [id])
}

model BusinessAddress {
  id          String   @id @default(uuid())

  businessId     String @unique

  locality String
  pinCode Int
  state String
  address String

  business     Business   @relation(fields: [businessId], references: [id])
}

model Orders {
  id String @id @default(uuid())

}
model Product{
  id String @id @default(uuid())

  
}

enum Role{
  ADMIN
  CUSTOMER
  SELLER
}
enum Account{
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATE
  BANNED
  CLOSED
}
enum BusinessCategory{
  ELECTRONICS
  FASHION
  GROCERY
  BEAUTY
  SPORTS
  HOME_APPLIANCES
  BOOKS
  TOYS
  OTHER
}